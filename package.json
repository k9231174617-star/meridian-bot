{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock'",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/meridian run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/meridian run dev",
    "bot:dev": "pnpm --filter @workspace/trading-bot run dev",
    "bot:paper": "pnpm --filter @workspace/trading-bot run paper",
    "bot:live": "pnpm --filter @workspace/trading-bot run live",
    "bot:backtest": "pnpm --filter @workspace/trading-bot run backtest",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "start": "pnpm --filter @workspace/api-server run start",
    "test": "pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run test",
    "smoke": "pnpm --filter @workspace/scripts run smoke",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1"
  }
}
