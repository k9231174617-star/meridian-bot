[Unit]
Description=Meridian Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/meridian-bot
EnvironmentFile=/opt/meridian-bot/.env
ExecStart=/usr/bin/pnpm bot:live
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/meridian-bot/.bot-data

[Install]
WantedBy=multi-user.target
